    "test:step2": "node --test test/step2.test.js",
    "test:step3": "node --test test/step3.test.js",
    "test:step4": "node --test test/step4.test.js",
    "test:step5": "node --test test/step5.test.js",
    "test:step6": "node --test test/step6.test.js",
    "test:step7": "node --test test/step7.test.js",
    "test:step8": "node --test test/step8.test.js",
    "send": "node scripts/send-test-event.js"
